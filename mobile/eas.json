{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:5001" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://onegai-server-production.up.railway.app", "EXPO_PUBLIC_LEGAL_BASE_URL": "https://jihyun808.github.io/onegai" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://onegai-server-production.up.railway.app", "EXPO_PUBLIC_LEGAL_BASE_URL": "https://jihyun808.github.io/onegai" }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
