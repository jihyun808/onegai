FLASK_ENV=development
SECRET_KEY=dev-secret-key

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=karaokedayo
MYSQL_POOL_SIZE=8
MYSQL_TIMEOUT=5
DB_SEARCH_ENABLED=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=86400

MANANA_BASE_URL=https://api.manana.kr
MANANA_TIMEOUT=8

KYSING_ENABLED=true
KYSING_TIMEOUT=10
KYSING_LYRICS_TIMEOUT=25

TJMEDIA_ENABLED=true
TJMEDIA_TIMEOUT=10

# 부가 기능 — 비워두면 해당 기능만 비활성화된다 (검색은 정상 동작)
# DeepL: https://www.deepl.com/pro-api  (무료 키는 ':fx'로 끝난다)
DEEPL_API_KEY=
DEEPL_TIMEOUT=8

# 가사는 금영 검색 결과에 딸려 온다. 키가 필요 없다.
# false로 두면 가사만 꺼지고 검색 링크는 그대로 나간다 (검색 기능은 영향 없음).
LYRICS_ENABLED=true

# 미리듣기(iTunes Search)는 키가 필요 없다
ITUNES_TIMEOUT=8

CORS_ORIGINS=http://localhost:5173
